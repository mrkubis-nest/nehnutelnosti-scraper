# ── Skopíruj tento súbor ako `.env` a vyplň hodnoty ─────────────────────────

# ── Email (Gmail SMTP) – VOLITEĽNÉ ──────────────────────────────────────────
# Necháš false, ak ti stačí zápis do Google Sheets.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=palkojakub1@gmail.com

# POZOR: NIE je to heslo do Google účtu, ale 16-znakové "App Password".
# Vygeneruješ ho na https://myaccount.google.com/apppasswords
# (vyžaduje zapnuté dvojfaktorové overenie). Vlož bez medzier.
SMTP_PASSWORD=

EMAIL_FROM=palkojakub1@gmail.com
EMAIL_TO=palkojakub1@gmail.com

# Poslať email aj keď nepribudli žiadne nové ponuky? (true/false)
EMAIL_ON_EMPTY=false

# ── Excel – HLAVNÝ VÝSTUP ───────────────────────────────────────────────────
# Súbor sa pri každom behu prepíše celý z databázy, takže vždy obsahuje
# kompletný zoznam. Nové ponuky sú zvýraznené a označené v stĺpci "Nové".
EXCEL_ENABLED=true
EXCEL_PATH=data/ponuky.xlsx

# ── Webstránka (textová tabuľka, bez fotiek) ────────────────────────────────
# Toto sa publikuje na GitHub Pages. Lokálne ju môžeš mať tiež zapnutú.
WEB_ENABLED=true
WEB_PATH=public/index.html

# ── Ostatné výstupy – VOLITEĽNÉ ─────────────────────────────────────────────
# CSV sa iba dopĺňa o nové riadky (oddeľovač ;)
CSV_ENABLED=false
CSV_PATH=data/ponuky.csv

# HTML prehľad s fotkami do prehliadača
HTML_ENABLED=false
HTML_PATH=data/ponuky.html

# ── Google Sheets – VOLITEĽNÉ ───────────────────────────────────────────────
SHEETS_ENABLED=false

# Cesta k JSON kľúču service accountu (návod v README, sekcia "Google Sheets")
GOOGLE_CREDENTIALS_FILE=credentials.json

# ID tabuľky – časť URL medzi /d/ a /edit
# https://docs.google.com/spreadsheets/d/<TOTO_JE_ID>/edit
SHEETS_SPREADSHEET_ID=
SHEETS_WORKSHEET=Ponuky

# ── Správanie crawlera ──────────────────────────────────────────────────────
# Pauza medzi requestami v sekundách. Nedávaj pod 0.8 – buďme slušní.
REQUEST_DELAY=1.2
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# Kam sa ukladá databáza už videných inzerátov
DB_PATH=data/seen.sqlite3

LOG_LEVEL=INFO
